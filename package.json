{
  "name": "markdown-docs-helper",
  "version": "1.0.5",
  "private": true,
  "description": "零依赖的 Markdown 文档浏览器：双击即可离线阅读，或起一个本地实时服务",
  "repository": "https://github.com/user/repo.git",
  "author": {
    "name" : "leon",
    "email": "leonstill@163.com"
  },
  "type": "module",
  "scripts": {
    "serve": "node build-docs.mjs --serve",
    "build": "node build-docs.mjs",
    "check": "node build-docs.mjs --check",
    "version:stamp": "node build-docs.mjs --stamp-version",
    "version:hook": "node build-docs.mjs --install-hook",
    "test": "node build-docs.mjs && node test/verify-render.mjs && node test/verify-search.mjs && node test/verify-mindmap.mjs && node test/verify-mermaid.mjs && node test/check-snapshot.mjs && node test/check-viewer.mjs && node test/check-realtime.mjs && node test/cli-args.mjs && node test/serve-smoke.mjs && node test/serve-bookmarks.mjs && node test/serve-host.mjs && node test/serve-port.mjs",
    "test:cli": "node test/cli-args.mjs",
    "test:search": "node test/verify-search.mjs",
    "test:mindmap": "node test/verify-mindmap.mjs",
    "test:mermaid": "node test/verify-mermaid.mjs",
    "test:realtime": "node test/check-realtime.mjs",
    "test:serve": "node test/serve-smoke.mjs",
    "test:bookmarks": "node test/serve-bookmarks.mjs",
    "test:serve-host": "node test/serve-host.mjs",
    "test:serve-port": "node test/serve-port.mjs",
    "test:ui": "node test/ui-verify.mjs",
    "test:xref-ui": "node test/xref-ui.mjs",
    "test:mindmap-ui": "node test/mindmap-ui.mjs",
    "test:mindmap-ui:realtime": "node test/mindmap-ui.mjs --realtime",
    "test:mermaid-ui": "node test/mermaid-ui.mjs",
    "test:mermaid-ui:realtime": "node test/mermaid-ui.mjs --realtime",
    "test:mermaid-style": "node test/mermaid-style-ui.mjs",
    "test:mermaid-labels": "node test/mermaid-labels-ui.mjs",
    "shots": "node test/shot-anim.mjs",
    "stale": "node test/why-stale.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
