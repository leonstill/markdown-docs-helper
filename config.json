{
  // ══════════════════════════════════════════════════════════════════
  //  config.json —— Markdown 文档浏览器的配置
  //  允许写 // 与 /* */ 注释、也允许尾随逗号，随便改，不会影响 md 文档本身。
  //  改完后：
  //    · 双击 md-viewer.html（file://）打开：跑一次  node build-docs.mjs  再刷新页面
  //    · 实时模式（node build-docs.mjs --serve）：刷新页面即可生效
  //  配置写错时页面会显示红色提示，并自动退回默认设置。
  // ══════════════════════════════════════════════════════════════════

  // ── 顶部工具栏标题 ────────────────────────────────────────────────
  "title": "Markdown 文档浏览器",
  "subtitle": "· markdown-docs-helper",

  // ── 首页（没有打开任何文档时显示的内容）─────────────────────────
  "home": {
    "title": "文档索引",
    // 首页引导语，支持 Markdown（标题/列表/粗体/代码/链接都行）；
    // 里面写 `docs/示例/xxx.md` 会自动变成可点击的跳转链接。留空 "" 则不显示。
    "intro": "本页只读展示文档目录下的 Markdown 文件，**绝不修改**任何原始文档。\n\n- **左侧目录栏**：左上角按钮或快捷键 `[` 开关；显示哪些文档由本文件控制\n- **右侧目录栏**：当前文档的标题大纲，右上角按钮或快捷键 `]` 开关\n- 正文里的 `§` 章节引用与行内 `docs/xxx.md` 都能点击跳转；`/` 聚焦搜索，`Ctrl+P` 打印或导出 PDF\n\n想看别的文档目录，用 `node build-docs.mjs --serve <目录>` 指过去即可（本文件里的 `docs/` 前缀不用改）。\n\n要调整标题、首页说明或左栏显示的内容，改本文件（`config.json`）。",
    // 是否在引导语下方显示文档卡片列表
    "showCards": true
  },

  // ── 左侧目录栏 ───────────────────────────────────────────────────
  "sidebar": {
    "title": "文档目录",
    "defaultOpen": false,
    "remember": true,
    "showSearch": true,
    "showCounts": true,

    // 只显示下面列出的目录（按此顺序）；label 是显示名，可随意改。
    // 写成空数组 [] 表示「显示文档目录下全部子目录」。
    "folders": [],

    // 额外排除的目录前缀或单个文件路径，例如 ["docs/草稿"]
    "exclude": [],

    // 想让某些文档排在前面时，按顺序写在这里，例如：
    // "order": ["docs/指南/快速开始.md"]
    "order": [],

    // 单篇覆盖：隐藏某篇，或改它的显示标题（都不会动 md 文件本身）。
    // 例如：
    // "docs/示例/表格与代码.md": { "hidden": true },
    // "docs/指南/快速开始.md": { "title": "改过的显示名" }
    "docs": {}
  },

  // ── 右侧目录栏（当前文档的标题大纲）──────────────────────────────
  "toc": {
    "title": "本篇目录",
    "defaultOpen": true,
    "remember": true,
    // 收录到几级标题：2 = 只到二级；3 = 到三级；4 = 最多四级
    "maxDepth": 4
  },

  // ── 阅读区 ───────────────────────────────────────────────────────
  "reading": {
    // 正文最大宽度（像素），觉得字太长或太窄就调它
    "maxWidth": 920
  }
}
