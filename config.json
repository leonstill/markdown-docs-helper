{
  // ══════════════════════════════════════════════════════════════════
  //  config.json —— Markdown 文档浏览器的配置
  //  允许写 // 与 /* */ 注释、也允许尾随逗号，随便改，不会影响 md 文档本身。
  //  改完后：
  //    · 实时模式（node build-docs.mjs --serve）：刷新页面即可生效（默认入口 index.html）
  //    · 双击 md-viewer.html（file://）打开：跑一次  node build-docs.mjs  再刷新页面
  //  配置写错时页面会显示红色提示，并自动退回默认设置。
  // ══════════════════════════════════════════════════════════════════

  // ── 顶部工具栏标题 ────────────────────────────────────────────────
  "title": "Markdown 文档浏览器",
  "subtitle": "首页",

  // ── 首页（没有打开任何文档时显示的内容）─────────────────────────
  "home": {
    "title": "文档索引",
    // 首页引导语，支持 Markdown（标题/列表/粗体/代码/链接都行）；
    // 里面写 `docs/示例/xxx.md` 会自动变成可点击的跳转链接。留空 "" 则不显示。
    "intro": "",
    // 是否在引导语下方显示文档卡片列表
    "showCards": true
  },

  // ── 左侧目录栏 ───────────────────────────────────────────────────
  "sidebar": {
    "title": "文档目录",
    "defaultOpen": false,
    "remember": true,
    "showSearch": true,
    "showCounts": true,

    // 只显示下面列出的目录（按此顺序）；label 是显示名，可随意改。
    // 写成空数组 [] 表示「显示文档目录下全部子目录」。
    "folders": [],

    // 额外排除的目录前缀或单个文件路径，例如 ["docs/草稿"]
    "exclude": [],

    // 想让某些文档排在前面时，按顺序写在这里，例如：
    // "order": ["docs/指南/快速开始.md"]
    "order": [],

    // 单篇覆盖：隐藏某篇，或改它的显示标题（都不会动 md 文件本身）。
    // 例如：
    // "docs/示例/表格与代码.md": { "hidden": true },
    // "docs/指南/快速开始.md": { "title": "改过的显示名" }
    "docs": {}
  },

  // ── 右侧目录栏（当前文档的标题大纲）──────────────────────────────
  "toc": {
    "title": "本篇目录",
    "defaultOpen": true,
    "remember": true,
    // 收录到几级标题：2 = 只到二级；3 = 到三级；4 = 最多四级
    "maxDepth": 4
  },

  // ── 阅读区 ───────────────────────────────────────────────────────
  "reading": {
    // 正文最大宽度（像素），觉得字太长或太窄就调它。
    // 页面上也可以直接拖正文左右边缘调宽窄（向外拖是两边对称变宽）：拖过的值记在本地、
    // 优先于这里，双击那条边就回到下面这个数。
    "maxWidth": 920
  },

  // ── 正文里的 HTML 怎么处理 ────────────────────────────────────────
  // 只影响 Markdown 正文里写的 HTML；```代码块里的 HTML 永远是源码文本。
  // 可选值（认不出的值一律按 escape 处理）：
  //   "escape"    转义显示（默认）：<div> 就显示成 <div> 这行文字，文档安全
  //   "innerhtml" 原样输出：浏览器真去渲染这些标签，可写 <details> 折叠块、
  //               <span style> 着色等；代价是文档获得页面全部权限（慎用，
  //               只对可信文档开；块级标签与 Markdown 混排时行距可能不太整齐）
  //   "strip"     吃掉标签只留内容：<div class="note">…</div> 只剩里面的文字，
  //               按普通 Markdown 排版；<br> 变换行、<img> 变图片（相对路径照常
  //               解析）、注释与 <script>/<style> 连内容一起消失，实体（&amp; 等）
  //               还原成字符。想统一套壳又不想让标签影响排版时用它
  "markdown": {
    "html": "strip"
  },

  // ── 思维导图（.mermaid 文件）──────────────────────────────────────
  // 文档目录里的 .mermaid（Mermaid mindmap 版式）会渲染成可缩放、可折叠的思维导图。
  // 渲染引擎已内置在页面里（vendor/markmap），离线也能用，不需要联网。
  "mindmap": {
    // 总开关：设成 false 后 .mermaid 只当普通文本显示，左栏也不再标「导图」
    "enabled": true,
    // 哪些后缀按思维导图渲染（写 "mermaid" 或 ".MERMAID" 都认）
    "extensions": [".mermaid"],
    // 打开时展开到第几层：1 = 只展开一级分支；2 = 再展开一层；0 = 全部展开；-1 = 全部折叠
    "initialExpandLevel": 2,
    // 右侧目录栏是否显示导图大纲（可点击定位、点三角折叠）
    "showOutline": true,
    // 是否显示导图工具栏上的 SVG / PNG 导出按钮
    "exportImage": true
  },

  // ── 嵌入的 Mermaid 图表（Markdown 里的 ```mermaid 围栏）────────────
  // 文档正文里这样写，就会在页面里画成图（不需要联网，引擎已内置 vendor/mermaid）：
  //   ```mermaid
  //   stateDiagram-v2
  //       [*] --> IDLE
  //       IDLE --> RUN : start
  //   ```
  // 支持 mermaid 全部版式：stateDiagram / stateDiagram-v2 / flowchart / sequenceDiagram /
  // classDiagram / erDiagram / gantt / pie / mindmap / timeline …（写错语法时保留源码并给出提示）
  "mermaid": {
    // 总开关：设成 false 后 ```mermaid 围栏退回普通代码块，页面里也不再塞这几个 MB 的引擎
    "enabled": true,
    // 配色：auto = 跟随页面深浅色自动切换；也可写死 mermaid 的主题名：
    // default / dark / forest / neutral / base
    "theme": "auto",
    // 观感：doc = 文档风（圆角浅紫状态胶囊 + 深紫描边 + 深灰连线 + 不透明浅灰标签底片，
    //              并顺带统一流程图节点/连线的线宽），plain = mermaid 原样
    "style": "doc",
    // 安全级别：strict（默认，标签里的 HTML 会被转义）/ loose（允许 <br/> 等标签，文档可信时才用）
    "securityLevel": "strict",
    // 每张图右上角的小工具栏（源码 / 复制 / SVG / 全屏）
    "controls": true,
    // 工具栏里是否给「SVG」导出按钮（导出的 SVG 自带主题样式，单独打开也对）
    "exportImage": true,
    // 工具栏里是否给「全屏」按钮（长图、宽图看起来更舒服，Esc 退出）
    "fullscreen": true
  }
}
